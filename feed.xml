---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"
      xml:lang="fr">

  <title type="text">{{ site.title | xml_escape }}</title>

  <link rel="self"
        type="application/atom+xml"
        href="{{ '/feed.xml' | absolute_url }}" />

  <link rel="alternate"
        type="text/html"
        href="{{ '/' | absolute_url }}" />

  <updated>{{ site.time | date_to_xmlschema }}</updated>

  <id>{{ '/feed.xml' | absolute_url }}</id>

  <author>
    <name>Timothée JULIEN</name>
    <email>email@timotheejulien.fr</email>
  </author>

  <generator uri="https://jekyllrb.com/"
             version="{{ jekyll.version }}">
    Jekyll {{ jekyll.version }}
  </generator>

  <rights>MIT license. Copyright © 2024-2025, Timothée JULIEN.</rights>

  {% for post in site.posts %}
  <entry>

    <title>{{ post.title | xml_escape }}</title>

    <link rel="alternate"
          type="text/html"
          href="{{ post.url | absolute_url }}" />

    <id>{{ post.url | absolute_url }}</id>

    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>

    <content type="html">{{ post.description | default: post.excerpt | xml_escape }}</content>

  </entry>
  {% endfor %}

</feed>
